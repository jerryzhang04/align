# Copy to .env in this folder. Never commit .env.
# Backend only — the browser must never receive these values.

# The key MUST be issued for whatever OMNI_BASE_URL points at.
# An OpenRouter token (sk-or-v1-...) is NOT valid against yibuapi.com: it 401s.
#
# Sponsor / Huawei OMNI track (needs a credential from the organizers):
#   OMNI_BASE_URL=https://yibuapi.com/v1
#   OMNI_MODEL=qwen3.5-omni-plus
#   OMNI_AUDIO_OUTPUT=true
#
# Development fallback on an OpenRouter key. Verified working: joint
# image+audio understanding in one turn, ~2s, text out only.
# This is NOT OMNI -- do not present it as OMNI in the demo.
#   OMNI_BASE_URL=https://openrouter.ai/api/v1
#   OMNI_MODEL=google/gemini-2.5-flash
#   OMNI_AUDIO_OUTPUT=false
OMNI_API_KEY=
OMNI_BASE_URL=https://yibuapi.com/v1
OMNI_MODEL=qwen3.5-omni-plus
OMNI_VOICE=Tina

# Request native speech from the model. Set false for providers that cannot
# emit audio, so the adapter skips a round trip that would 404.
OMNI_AUDIO_OUTPUT=true

# OMNI is the only speech vendor. If OMNI returns audio, the app plays it;
# otherwise the app shows captions. Do not add a second TTS/STT provider.
HOST=127.0.0.1
PORT=8788

# Optional. If set, the API requires Authorization: Bearer <token>.
# Leave empty for local development.
ALIGN_API_TOKEN=
