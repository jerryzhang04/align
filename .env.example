# Copy to .env in this folder. Never commit .env.
# Backend only — the browser must never receive these values.

OMNI_API_KEY=
OMNI_BASE_URL=https://yibuapi.com/v1
OMNI_MODEL=qwen3.5-omni-plus
OMNI_VOICE=Tina
PORT=8788

# Optional. If set, the API requires Authorization: Bearer <token>.
# Leave empty for local development.
ALIGN_API_TOKEN=
