# Copy to .env in this folder. Never commit .env.
# Backend only — the browser must never receive these values.

# Use only the sponsor-issued YibuAPI credential. Other providers are rejected.
OMNI_API_KEY=
OMNI_BASE_URL=https://yibuapi.com/v1
OMNI_MODEL=qwen3.5-omni-plus
OMNI_VOICE=Tina

# Request native speech from OMNI. Set false only for a Yibu configuration
# that does not expose audio output; captions remain available.
OMNI_AUDIO_OUTPUT=true

# OMNI is the only speech vendor. If OMNI returns audio, the app plays it;
# otherwise the app shows captions. Do not add a second TTS/STT provider.
HOST=127.0.0.1
PORT=8788

# Optional. If set, the API requires Authorization: Bearer <token>.
# Leave empty for local development.
ALIGN_API_TOKEN=
